* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    /* Pastel Rainbow Colors - Light Mode */
    --pastel-red: hsl(354, 100%, 85%);
    --pastel-orange: hsl(33, 100%, 87%);
    --pastel-yellow: hsl(42, 95%, 89%);
    --pastel-green: hsl(144, 70%, 92%);
    --pastel-blue: hsl(210, 100%, 87%);
    --pastel-purple: hsl(270, 100%, 87%);
    --pastel-pink: hsl(330, 100%, 85%);
    
    /* Fonts - matching main site */
    --heading-font: 'Fredoka One', cursive;
    --body-font: 'Comic Neue', cursive;
    
    /* Colors - Light Mode */
    --bg-primary: white;
    --bg-secondary: #f8f8f8;
    --text-primary: #333;
    --text-secondary: #666;
    --nav-gradient-start: hsla(354, 100%, 85%, 0.75);
    --nav-gradient-end: hsla(330, 100%, 85%, 0.75);
    
    /* Spacing */
    --space-sm: 0.5rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2rem;
    --space-xxl: 3rem;
}

/* Vaporwave Dark Mode Colors */
.dark-mode {
    /* Accent Colors - Dark Mode (more sophisticated) */
    --pastel-red: #ff6b95;
    --pastel-orange: #b57dff;
    --pastel-yellow: #ffd166;
    --pastel-green: #4fd8eb;
    --pastel-blue: #59a5ff;
    --pastel-purple: #9d5de0;
    --pastel-pink: #ff7eb6;
    
    /* Colors - Dark Mode */
    --bg-primary: #121212;
    --bg-secondary: #1e1e1e;
    --text-primary: #f0f0f0;
    --text-secondary: #d0d0d0;
    --nav-gradient-start: rgba(45, 50, 80, 0.85);
    --nav-gradient-end: rgba(85, 33, 85, 0.85);
    /* Add the footer background color variable to ensure consistency */
    --bg-footer: #1e1537;
}

/* ================ */
/* Dark Mode Toggle */
/* ================ */
.theme-toggle {
    position: fixed;
    top: 85px;
    right: 20px;
    z-index: 2000;
    display: flex;
    align-items: center;
}

.toggle-wrapper {
    position: relative;
    width: 60px;
    height: 30px;
    margin-left: 10px;
}

.toggle-input {
    opacity: 0;
    width: 0;
    height: 0;
}

.toggle-label {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, #f6a3ef, #dd6dfb);
    display: flex;
    align-items: center;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.4s ease;
    overflow: hidden;
}

.toggle-label:before {
    content: "";
    position: absolute;
    width: 22px;
    height: 22px;
    left: 4px;
    bottom: 4px;
    border-radius: 50%;
    background: white;
    transition: all 0.4s ease;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
}

.toggle-icons {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 8px;
    pointer-events: none;
    color: white;
    z-index: 2;
}

.toggle-icons i {
    font-size: 14px;
}

.toggle-input:checked + .toggle-label {
    background: linear-gradient(90deg, #4900ff, #ff00c1);
}

.toggle-input:checked + .toggle-label:before {
    transform: translateX(30px);
    background: #00fff9;
}

body {
    font-family: var(--body-font);
    background: var(--bg-primary);
    color: var(--text-primary);
}

a {
    text-decoration: none;
    color: inherit;
}

/* ================ */
/* Navigation */
/* ================ */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: linear-gradient(90deg, 
        hsla(354, 100%, 85%, 0.75),  /* pastel red */
        hsla(33, 100%, 87%, 0.75),   /* pastel orange */
        hsla(42, 95%, 89%, 0.75),    /* pastel yellow */
        hsla(144, 70%, 92%, 0.75),   /* pastel green */
        hsla(210, 100%, 87%, 0.75),  /* pastel blue */
        hsla(270, 100%, 87%, 0.75),  /* pastel purple */
        hsla(330, 100%, 85%, 0.75)   /* pastel pink */
    );
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
    z-index: 1000;
    padding: var(--space-sm) 0;
    border-radius: 0 0 20px 20px;
}

/* Dark mode navbar styling */
.dark-mode .navbar {
    background: linear-gradient(90deg, 
        rgba(45, 50, 80, 0.85),
        rgba(65, 40, 95, 0.85),
        rgba(255, 209, 102, 0.5),
        rgba(79, 216, 235, 0.5),
        rgba(89, 165, 255, 0.5),
        rgba(157, 93, 224, 0.85),
        rgba(85, 33, 85, 0.85)
    );
    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);
}

.navbar .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-md);
}

.logo {
    display: flex;
    align-items: center;
    height: 60px;
}

.logo-image {
    height: 50px;
    width: auto;
    transition: transform 0.3s ease;
}

.logo:hover .logo-image {
    transform: scale(1.1);
}

.mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    font-size: 1.5rem;
    color: white;
    cursor: pointer;
    z-index: 1001;
    padding: 0.5rem;
}

.nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
}

.nav-links a {
    font-size: 1.1rem;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: white;
    text-decoration: none;
    position: relative;
    padding: 5px 8px;
}

.nav-links a:hover {
    color: white;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 10px;
}

.nav-links a.active {
    color: white;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    font-weight: bold;
}

.nav-links a.btn {
    padding: var(--space-sm) var(--space-md);
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 50px;
}

.nav-links a.btn:hover {
    background-color: var(--pastel-pink);
    color: white;
    transform: translateY(-3px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
}

/* ================ */
/* Mobile Navigation */
/* ================ */
@media (max-width: 768px) {
    .mobile-menu-btn {
        display: block;
    }

    .nav-links {
        position: fixed;
        top: 77px;
        left: 0;
        width: 100%;
        height: auto;
        max-height: 0;
        background: linear-gradient(180deg, 
            hsla(354, 100%, 85%, 0.4),
            hsla(33, 100%, 87%, 0.4),
            hsla(42, 95%, 89%, 0.4),
            hsla(144, 70%, 92%, 0.4),
            hsla(210, 100%, 87%, 0.4),
            hsla(270, 100%, 87%, 0.4),
            hsla(330, 100%, 85%, 0.4)
        );
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        flex-direction: column;
        align-items: center;
        padding: 0;
        overflow: hidden;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 999;
        border-radius: 20px 20px 20px 20px;
        box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
    }

    .nav-links.active {
        max-height: 400px;
        padding: 1rem 0;
    }

    .nav-links a {
        width: 80%;
        padding: 0.75rem;
        margin: 0.25rem 0;
        text-align: center;
        font-size: 1.1rem;
        opacity: 0;
        transform: translateY(-10px);
        transition: all 0.3s ease;
        justify-content: center;
        background: rgba(255, 255, 255, 0.2);
        border-radius: 10px;
    }

    .nav-links.active a {
        opacity: 1;
        transform: translateY(0);
        transition-delay: calc(0.1s * var(--i));
    }

    .mobile-menu-btn.active i::before {
        content: '\f00d';
    }
    
    /* Position toggle at bottom on mobile */
    .theme-toggle {
        top: auto;
        bottom: 20px;
        right: 20px;
    }
}

.resize-animation-stopper * {
    animation: none !important;
    transition: none !important;
}

/* Remove the old header styles */
header {
    position: relative;
}

/* Page title styling */
.page-title {
    text-align: center;
    padding: 1.5rem 0;
    margin-top: 100px;
    margin-bottom: 0;
}

.page-title h1 {
    font-family: var(--heading-font);
    font-weight: normal;
    color: #6a5acd;
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
}

.page-title p {
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
}

/* Enhanced dark mode styling for gallery page */
.dark-mode .page-title h1 {
    color: var(--pastel-blue);
    text-shadow: 0 0 10px rgba(79, 216, 235, 0.3);
}

.dark-mode .page-title p {
    color: var(--text-secondary);
}

/* Gallery styles */
.gallery-grid {
    margin-top: 25px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    grid-auto-rows: 250px;
    gap: 0;
    position: relative;
}

/* Fix grid gaps in dark mode */
.dark-mode .gallery-grid {
    gap: 0;
    border-collapse: collapse;
}

.gallery-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
    transition: 
        opacity 0.3s ease-in-out,
        transform 0.3s ease-in-out;
    opacity: 1;
    transform: translateY(0);
}

.gallery-grid img.fade-out {
    opacity: 0;
    transform: translateY(-20px);
}

.gallery-grid img.fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeIn 0.3s ease-in forwards;
}

@keyframes fadeIn {
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.gallery-grid img:hover {
    transform: scale(0.95);
    z-index: 10;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
}

/* Enhance gallery items in dark mode */
.dark-mode .gallery-grid img {
    border: none;
    margin: 0;
    padding: 0;
}

.viewer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    padding: 40px;
    background: rgba(18, 18, 18, 0.95);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 200;
}

.viewer.active {
    display: flex;
    animation: viewerFade 0.3s ease;
}

@keyframes viewerFade {
    from { opacity: 0; }
    to { opacity: 1; }
}

/* Gallery viewer dark mode improvements */
.dark-mode .viewer {
    background: rgba(18, 18, 18, 0.97);
    backdrop-filter: blur(10px);
}

.viewer-content {
    max-width: 90%;
    max-height: 90%;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
}

.viewer-img {
    max-width: 100%;
    max-height: 90vh;
    object-fit: contain;
    transition: opacity 0.3s ease;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
}

.nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: white;
    font-size: 2rem;
    width: 50px;
    height: 50px;
    cursor: pointer;
    border-radius: 50%;
    transition: all 0.3s ease;
}

.nav-btn:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: translateY(-50%) scale(1.1);
}

.prev {
    left: -75px;
}

.next {
    right: -75px;
}

.close-btn {
    position: absolute;
    top: -40px;
    right: -40px;
    background: rgba(255, 255, 255, 0.2);
    border: none;
    color: white;
    font-size: 1.5rem;
    width: 40px;
    height: 40px;
    cursor: pointer;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
}

.close-btn:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: scale(1.1);
}

/* Category styling */
.folder-title {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
    color: white;
    padding: 15px;
    font-family: var(--heading-font);
    font-weight: normal;
    font-size: 1.3rem;
}

.back-btn {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, rgba(50, 50, 50, 0.1) 100%);
    border: none;
    opacity: 0;
    transition: all 0.3s ease;
    cursor: pointer;
    font-size: 2.5rem;
    color: white;
    overflow: hidden;
}

.back-btn.visible {
    opacity: 1;
}

.back-btn:hover {
    background: radial-gradient(circle, rgba(255, 255, 255, 0.15) 0%, rgba(50, 50, 50, 0.15) 100%);
    transform: scale(0.98);
}

.back-btn i {
    font-size: 2.5rem;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    transition: transform 0.3s ease;
}

.back-btn:hover i {
    transform: translateX(-5px);
}

.back-cell {
    min-width: 250px;
    height: 250px;
}

.dark-mode .folder-title {
    background: linear-gradient(transparent, rgba(30, 30, 40, 0.9));
    text-shadow: 0 0 10px rgba(79, 216, 235, 0.3);
}

/* Ensure backdrop overlay works */
body.menu-open::after {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    backdrop-filter: blur(5px) !important;
    -webkit-backdrop-filter: blur(5px) !important;
    z-index: 998;
    background-color: rgba(255, 255, 255, 0.05);
    pointer-events: none;
}

.dark-mode .nav-btn,
.dark-mode .close-btn {
    background: rgba(60, 60, 70, 0.5);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.dark-mode .nav-btn:hover,
.dark-mode .close-btn:hover {
    background: rgba(79, 216, 235, 0.3);
}

/* ================ */
/* Footer */
/* ================ */
.footer {
    background-color: #2e2b4a;
    color: white;
    padding: 50px 0 20px 0;
    text-align: center;
    position: relative;
    margin-top: 50px;
}

.footer-content {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
}

.footer-section {
    flex: 1;
    padding: 0 15px;
    margin-bottom: 20px;
    min-width: 250px;
}

.footer-about, .footer-links, .footer-contact {
    text-align: center;
}

.footer h3 {
    color: #fff;
    margin-bottom: 15px;
    font-weight: 700;
}

.footer p {
    line-height: 1.5;
    margin-bottom: 10px;
}

.social-menu {
    display: flex;
    justify-content: center;
    margin-top: 15px;
    gap: 15px;
}

.social-menu a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #3d3a63;
    transition: all 0.3s ease;
    color: white;
    text-decoration: none;
}

.social-menu a:hover {
    transform: translateY(-3px);
    background: #5f5a9a;
}

.footer-links ul {
    list-style: none;
    padding: 0;
}

.footer-links ul li {
    margin-bottom: 10px;
}

.footer-links a {
    color: white;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    transition: all 0.3s ease;
}

.footer-links a i {
    margin-right: 5px;
}

.footer-links a:hover {
    color: #ff61d8;
    transform: translateX(5px);
    text-decoration: none;
}

.footer-contact a {
    color: white;
    text-decoration: none;
    transition: all 0.3s ease;
    display: block;
    margin-bottom: 10px;
}

.footer-contact a:hover {
    color: #61d8ff;
    text-decoration: none;
}

.footer-bottom {
    text-align: center;
    padding-top: 20px;
    border-top: 1px solid #3d3a63;
    margin-top: 20px;
}

.footer-bottom p {
    font-size: 14px;
}

.footer-bottom .heart {
    color: #ff61d8;
    font-size: 16px;
    animation: heartbeat 1.5s infinite;
}

@keyframes heartbeat {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.2); }
}

/* Dark mode footer styles */
.dark-mode .footer {
    background-color: var(--bg-footer);
}

.dark-mode .social-menu a {
    background: #342b59;
}

.dark-mode .social-menu a:hover {
    background: #4e3d8b;
}

.dark-mode .footer-links a:hover {
    color: #ff61d8;
}

.dark-mode .footer-contact a:hover {
    color: #61d8ff;
}

.dark-mode .footer-bottom {
    border-top: 1px solid #342b59;
}