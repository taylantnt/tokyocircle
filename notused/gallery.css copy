}

/* Remove the old header styles */
header {
    position: relative;
}

/* Page title styling */
.page-title {
    text-align: center;
    padding: 1.5rem 0;
    margin-top: 100px;
    margin-bottom: 0;
}

.page-title h1 {
    font-family: var(--heading-font);
    font-weight: normal;
    color: #6a5acd;
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
}

.page-title p {
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto;
}

/* Enhanced dark mode styling for gallery page */
.dark-mode .page-title h1 {
    color: var(--pastel-blue);
    text-shadow: 0 0 10px rgba(79, 216, 235, 0.3);
}

.dark-mode .page-title p {
    color: var(--text-secondary);
}

/* Gallery styles */
.gallery-grid {
    margin-top: 25px;
  margin-bottom: 100px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    grid-auto-rows: 250px;
    gap: 0;
    position: relative;
}

/* Fix grid gaps in dark mode */
.dark-mode .gallery-grid {
    gap: 0;
    border-collapse: collapse;
}

.gallery-grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    cursor: pointer;
    transition: 
        opacity 0.3s ease-in-out,
        transform 0.3s ease-in-out;
    opacity: 1;
    transform: translateY(0);
}

.gallery-grid img.fade-out {
    opacity: 0;
    transform: translateY(-20px);
}

.gallery-grid img.fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: fadeIn 0.3s ease-in forwards;
}

@keyframes fadeIn {
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.gallery-grid img:hover {
    transform: scale(0.95);
    z-index: 10;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
}

/* Enhance gallery items in dark mode */
.dark-mode .gallery-grid img {
    border: none;
    margin: 0;
    padding: 0;
}

.viewer {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    padding: 40px;
    background: rgba(18, 18, 18, 0.95);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2000;
}

/* Hide navbar when viewer is active */
.viewer.active ~ .navbar,
body:has(.viewer.active) .navbar {
    visibility: hidden;
    opacity: 0;
    transition: visibility 0.3s, opacity 0.3s;
}

.viewer.active {
    display: flex;
    animation: viewerFade 0.3s ease;
}

@keyframes viewerFade {
    from { opacity: 0; }
    to { opacity: 1; }
}

