* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    /* Pastel Rainbow Colors - Light Mode */
    --pastel-red: hsl(354, 100%, 85%);
    --pastel-orange: hsl(33, 100%, 87%);
    --pastel-yellow: hsl(42, 95%, 89%);
    --pastel-green: hsl(144, 70%, 92%);
    --pastel-blue: hsl(210, 100%, 87%);
    --pastel-purple: hsl(270, 100%, 87%);
    --pastel-pink: hsl(330, 100%, 85%);
    
    /* Fonts - matching main site */
    --heading-font: 'Fredoka One', cursive;
    --body-font: 'Comic Neue', cursive;
    
    /* Colors - Light Mode */
    --bg-primary: white;
    --bg-secondary: #f8f8f8;
    --text-primary: #333;
    --text-secondary: #666;
    --nav-gradient-start: hsla(354, 100%, 85%, 0.65);
    --nav-gradient-end: hsla(330, 100%, 85%, 0.65);
    --nav-backdrop-blur: 10px;
    --bg-footer: #6a5acd;
    
    /* Spacing */
    --space-sm: 0.5rem;
    --space-md: 1rem;
    --space-lg: 1.5rem;
    --space-xl: 2rem;
    --space-xxl: 3rem;
}

/* Vaporwave Dark Mode Colors */
.dark-mode {
    /* Accent Colors - Dark Mode (more sophisticated) */
    --pastel-red: #ff6b95;
    --pastel-orange: #b57dff;
    --pastel-yellow: #ffd166;
    --pastel-green: #4fd8eb;
    --pastel-blue: #59a5ff;
    --pastel-purple: #9d5de0;
    --pastel-pink: #ff7eb6;
    
    /* Colors - Dark Mode */
    --bg-primary: #121212;
    --bg-secondary: #1e1e1e;
    --text-primary: #f0f0f0;
    --text-secondary: #d0d0d0;
    --nav-gradient-start: rgba(45, 50, 80, 0.85);
    --nav-gradient-end: rgba(85, 33, 85, 0.85);
    --bg-footer: #1e1537;  /* Dark purple for dark mode */
}

        h1, h2, h3, h4 {
            font-family: var(--heading-font);
            font-weight: normal;
            color: white;
        }

        /* Enhanced divider line at the overlap point */
        .founders::before,
