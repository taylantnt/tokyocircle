/* ================ */
/* Dark Mode Toggle */
/* ================ */
.theme-toggle {
    position: fixed;
    top: 85px;
    right: 20px;
    z-index: 2000;
    display: flex;
    align-items: center;
}

.toggle-wrapper {
    position: relative;
    width: 60px;
    height: 30px;
    margin-left: 10px;
}

.toggle-input {
    opacity: 0;
    width: 0;
    height: 0;
}

.toggle-label {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, #f6a3ef, #dd6dfb);
    display: flex;
    align-items: center;
    border-radius: 30px;
    cursor: pointer;
    transition: all 0.4s ease;
    overflow: hidden;
}

.toggle-label:before {
    content: "";
    position: absolute;
    width: 22px;
    height: 22px;
    left: 4px;
    bottom: 4px;
    border-radius: 50%;
    background: white;
    transition: all 0.4s ease;
    display: flex;
    justify-content: center;
    align-items: center;
    box-shadow: 0 2px 5px rgba(0,0,0,0.2);
}

.toggle-icons {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 8px;
    pointer-events: none;
    color: white;
    z-index: 2;
}

.toggle-icons i {
    font-size: 14px;
}

.toggle-input:checked + .toggle-label {
    background: linear-gradient(90deg, #4900ff, #ff00c1);
}

.toggle-input:checked + .toggle-label:before {
    transform: translateX(30px);
    background: #00fff9;
}

body {
    font-family: var(--body-font);
    background: var(--bg-primary);
    color: var(--text-primary);
}

/* ================ */
/* Navigation */
/* ================ */
.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    background: linear-gradient(90deg, 
        hsla(354, 100%, 85%, 0.75),  /* pastel red */
        hsla(33, 100%, 87%, 0.75),   /* pastel orange */
        hsla(42, 95%, 89%, 0.75),    /* pastel yellow */
        hsla(144, 70%, 92%, 0.75),   /* pastel green */
        hsla(210, 100%, 87%, 0.75),  /* pastel blue */
        hsla(270, 100%, 87%, 0.75),  /* pastel purple */
        hsla(330, 100%, 85%, 0.75)   /* pastel pink */
    );
    backdrop-filter: blur(var(--nav-backdrop-blur));
    -webkit-backdrop-filter: blur(var(--nav-backdrop-blur));
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
    z-index: 1000;
    padding: var(--space-sm) 0;
    border-radius: 0 0 20px 20px;
}

/* Dark mode navbar */
        .dark-mode .navbar {
            background: linear-gradient(90deg, 
                var(--nav-gradient-start),
                rgba(150, 0, 255, 0.35),
                rgba(238, 205, 105, 0.35),
                rgba(0, 255, 249, 0.35),
                rgba(0, 184, 255, 0.35),
                rgba(126, 16, 143, 0.35),
                var(--nav-gradient-end)
            );

}

.navbar .container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--space-md);
}

